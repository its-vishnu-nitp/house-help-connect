# House Help Connect — Backend environment variables
# Copy this file to ".env" and fill in your own values. Never commit the real .env.

# MongoDB connection string (local or Atlas)
MONGO_URL=mongodb://localhost:27017/house-help-connect

# Secret used to sign JWT auth tokens — use a long random string
JWT_SECRET=your-long-random-secret-here

# JWT lifetime (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Port the API server listens on
PORT=5500

# Allowed frontend origin for CORS (your deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173

# Environment: development | production
NODE_ENV=development
